{% extends "default/module.html.jinja2" %}

{% block title %}
  {% if module.name == root_module_name %}
    {{ module.modulename }} v{{ module.obj.version.version }} API documentation
  {% else %}
    {{ super() }}
  {% endif %}
{% endblock %}

{% block nav_title %}
  {{ super() }}
  {% if module.name == root_module_name %}
    <small>v{{ module.obj.version.version }}</small>
  {% endif %}
{% endblock %}

{% defaultmacro module_name() %}
    <h1 class="modulename">
        {% set parts = module.modulename.split(".") %}
        {% for part in parts %}
            {%- set fullname = ".".join(parts[:loop.index]) -%}
            {%- if fullname in all_modules and fullname != module.modulename -%}
                <a href="./{{ "../" * loop.revindex0 }}{{ part }}.html">{{ part }}</a>
            {%- else -%}
                {{ part }}
            {%- endif -%}
            {%- if loop.nextitem -%}
                <wbr>.
            {%- endif -%}
        {% endfor %}
        {% if module.name == root_module_name %}
          v{{ module.obj.version.version }}
        {% endif %}
    </h1>
{% enddefaultmacro %}


{% block head %}
{{ super() }}
<style>
  .code-container {
    position: relative;
    margin: 20px 0;
  }

  .code-header {
    background-color: #e9ecef;
    padding: 8px 12px;
    border-radius: 4px 4px 0 0;
    font-size: 12px;
    font-weight: bold;
    color: #495057;
    border-bottom: 1px solid #dee2e6;
  }

  .code-wrapper {
    position: relative;
    background-color: #f5f5f5;
    border-radius: 0 0 4px 4px;
  }

  .copy-btn {
    position: absolute;
    top: 10px;
    right: 10px;
    padding: 8px 12px;
    background-color: #007bff;
    color: white;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    font-size: 14px;
    z-index: 10;
  }

  .copy-btn:hover {
    background-color: #0056b3;
  }

  .copy-btn.copied {
    background-color: #28a745;
  }

  pre {
    padding: 15px;
    padding-left: 50px;
    margin: 0;
    overflow-x: auto;
    counter-reset: line-number;
  }

  .line {
    display: block;
    counter-increment: line-number;
  }

  .line::before {
    content: counter(line-number);
    display: inline-block;
    width: 30px;
    margin-right: 15px;
    text-align: right;
    color: #999;
    font-size: 12px;
    user-select: none;
  }
</style>
{% endblock %}

{% block search_js %}
{{ super() }}
<script>
  document.querySelectorAll('pre code').forEach(code => {
    const pre = code.parentElement;

    // Get language from pre data attribute
    const language = pre.getAttribute('lang') || 'Code';

    // Save original text for copying
    const originalText = code.textContent.replace(/\n$/, '');

    // Create container
    const container = document.createElement('div');
    container.className = 'code-container';

    // Create header
    const header = document.createElement('div');
    header.className = 'code-header';
    header.textContent = language;

    // Create wrapper
    const wrapper = document.createElement('div');
    wrapper.className = 'code-wrapper';

    // Create copy button
    const button = document.createElement('button');
    button.className = 'copy-btn';
    button.textContent = 'Copy';
    button.onclick = function() {
      navigator.clipboard.writeText(originalText).then(() => {
        this.textContent = 'Copied!';
        this.classList.add('copied');
        setTimeout(() => {
          this.textContent = 'Copy';
          this.classList.remove('copied');
        }, 2000);
      });
    };

    // Wrap existing content in line spans without modifying HTML
    const html = code.innerHTML;
    const lines = html.split('\n').filter((line, i, arr) => !(i === arr.length - 1 && line === ''));
    code.innerHTML = lines.map(line => `<span class="line">${line}</span>`).join('');

    // Assemble
    pre.parentNode.insertBefore(container, pre);
    container.appendChild(header);
    container.appendChild(button);
    wrapper.appendChild(pre);
    container.appendChild(wrapper);
  });
</script>
{% endblock %}
